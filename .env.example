# Application
APP_NAME=AI Merchant Sales API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# Merchant manifest (/.well-known/ai-commerce)
MERCHANT_ID=00000000-0000-0000-0000-000000000001
MERCHANT_NAME=TechStore
MERCHANT_CURRENCY=INR
MERCHANT_COUNTRY=IN
MERCHANT_API_VERSION=1.0
MERCHANT_API_BASE_URL=http://localhost:8000/api/v1
ENABLED_PAYMENT_GATEWAYS=["razorpay"]

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_merchant_sales
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# API authentication and signing
# Generate long, random values locally. Never commit real credentials.
API_KEY_PEPPER=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Transaction safety
IDEMPOTENCY_KEY_TTL_SECONDS=86400
QUOTE_VALIDITY_SECONDS=300

# Rate limiting
# In-memory limits are suitable only for local development. Use Redis in a
# multi-process or production deployment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=memory://
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Pricing defaults
DEFAULT_TAX_RATE=0.18
DEFAULT_SHIPPING_AMOUNT=0.00

# Observability and browser access
AUDIT_LOG_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
